      "command": "executeScript",
      "target": "var start = new Date(1950, 0, 1);  var end = new Date(2003, 11, 31);  var randomDOB = new Date(start.getTime() + Math.random() * (end.getTime() - start.getTime()));  return randomDOB.toISOString().split('T')[0]; ",
      "targets": [],
      "value": "random_dob"
