@page "/therapy-template/{id:int}/edit"
@inject TherapyTemplateRepository repository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager
 
<PageHeader Title="Modifica Terapia Precompilata" /> 

<EditForm Model="@model" OnValidSubmit="@SaveTask" class="needs-validation" novalidate>
    <DataAnnotationsValidator />
    @if (!string.IsNullOrEmpty(warningMessage))
    {
        <div class="alert alert-warning" role="alert">
            @warningMessage
        </div>
    }
    <div class="row g-3">
        <div class="col-12">
            <label for="Title">Titolo:</label>
            <InputText id="Title" @bind-Value="model.Title" class="form-control" autocomplete="off" />
            <ValidationMessage For="@(() => model.Title)" />
        </div>
    </div>
    <div class="row g-3">
        <div class="col-12">
            <label for="Description">Descrizione:</label>
            <InputTextArea id="Description" @bind-Value="model.Description" class="form-control" />
            <ValidationMessage For="@(() => model.Description)" />
        </div>
    </div>
    <hr class="my-4">
    <CancelButton Url="/therapy-templates" />
    <AnchorButton ButtonText="Rimuovi" ButtonClass="outline-danger btn-delete-soft" Url="@($"/therapy-template/{Id}/delete/")"></AnchorButton>
    <SubmitButton />
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private TherapyTemplate model;
    private string warningMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveTask()
    {
        try
        {
            await repository.UpdateAsync(model);
            await unitOfWork.SaveChangesAsync();
            navigationManager.NavigateTo("/therapy-templates");
        }
        catch (Exception ex)
        {
            warningMessage = ValidationExceptionMapper.ToUserMessage(ex);
        }
    }
}
