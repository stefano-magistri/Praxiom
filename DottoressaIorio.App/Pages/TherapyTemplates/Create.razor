@page "/create-therapy-template"
@inject TherapyTemplateRepository repository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager
@inject DottoressaIorio.Services.Backup.IOnlineBackupService onlineBackupService
@inject ILicenseService licenseService

<PageHeader Title="Nuova terapia precompilata"/>

<EditForm Model="@model" OnValidSubmit="@SaveAsync" class="needs-validation" novalidate>
    <DataAnnotationsValidator/>
    <ValidationWarningAlert Message="@warningMessage"/>
    <TrialExpiredAlert/>
    <div class="row g-3">
        <div class="col-12">
            <label for="Title" class="form-label">Titolo</label>
            <InputText id="Title" @bind-Value="model.Title" class="form-control" autocomplete="off"/>
            <ValidationMessage For="@(() => model.Title)"/>
        </div>
    </div>
    <TherapyDescriptionField Label="Descrizione"
                             InputId="TemplateDescription"
                             AriaLabel="Descrizione terapia precompilata"
                             TestId="template-description-editor"
                             Value="@EditorDescription"
                             ValueChanged="OnDescriptionChanged"
                             For="@(() => model.Description)"/>
    <StandardFormActions CancelUrl="/therapy-templates" SubmitDisabled="@licenseService.IsTrialExpired"/>
</EditForm>

@code {
    private readonly TherapyTemplate model = new();
    private string warningMessage = "";
    private string EditorDescription => StringExtensions.ToEditorValue(model.Description);

    protected override async Task OnInitializedAsync()
    {
        await licenseService.InitializeAsync();
    }

    private async Task SaveAsync()
    {
        var trialMessage = await licenseService.GetTherapyTemplateCreationBlockMessageAsync();
        if (!string.IsNullOrWhiteSpace(trialMessage))
        {
            warningMessage = trialMessage;
            return;
        }

        if (await repository.TitleExistsAsync(model.Title))
        {
            warningMessage = "Il titolo giá esiste.";
            return;
        }

        try
        {
            model.Description = StringExtensions.NormalizeStoredRichText(model.Description);
            await repository.AddAsync(model);
            await unitOfWork.SaveChangesAsync();
            try
            {
                await onlineBackupService.TriggerBackupAsync("therapy-template-create");
            }
            catch
            {
                // Backup failures must not block the user save flow.
            }

            navigationManager.NavigateTo("/therapy-templates");
        }
        catch (Exception ex)
        {
            warningMessage = ValidationExceptionMapper.ToUserMessage(ex);
        }
    }

    private Task OnDescriptionChanged(string value)
    {
        model.Description = value;
        return Task.CompletedTask;
    }

}

