@page "/therapy-templates"

@inject TherapyTemplateRepository repository
@inject NavigationManager navigationManager
@inject ILicenseService licenseService


<PageHeader Title="Terapie Precompilate"/>

<div class="card patients-card">
    <div class="card-body p-4">
        <div class="patients-toolbar mb-3">
            <div class="patients-toolbar-search">
                <SearchBox Id="templateSearch"
                           Value="@SearchTerm"
                           OnInput="SearchTemplates"
                           Placeholder="Cerca terapia precompilata per titolo o descrizione"/>
            </div>
            <div class="patients-toolbar-actions">
                @if (licenseService.IsTrialExpired)
                {
                    <button class="btn btn-primary"
                            data-testid="create-therapy-template-page-link"
                            type="button"
                            title="Nuova Terapia Precompilata"
                            aria-label="Nuova Terapia Precompilata"
                            disabled>
                        <span class="oi oi-plus" aria-hidden="true"></span>
                    </button>
                }
                else
                {
                    <a class="btn btn-primary"
                       data-testid="create-therapy-template-page-link"
                       href="/create-therapy-template"
                       title="Nuova Terapia Precompilata"
                       aria-label="Nuova Terapia Precompilata">
                        <span class="oi oi-plus" aria-hidden="true"></span>
                    </a>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(CreationInlineMessage))
        {
            <p class="trial-inline-message">@CreationInlineMessage</p>
        }

        @if (DisplayedTemplates.Count == 0)
        {
            <p class="mb-0">Nessuna terapia precompilata trovata.</p>
        }
        else
        {
            @if (TotalPages > 1)
            {
                <Pagination CurrentPage="CurrentPage"
                            TotalPages="TotalPages"
                            SelectedPage="HandleSelectedPage"
                            PreviousPage="PreviousPage"
                            NextPage="NextPage"/>
            }

            <div class="table-responsive patients-table-wrapper">
                <table class="table table-sm table-hover align-middle mb-0 patients-table">
                    <thead>
                    <tr>
                        <th>Titolo</th>
                        <th>Descrizione</th>
                        <th class="text-end">Azioni</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var template in DisplayedTemplates)
                    {
                        <tr>
                            <td class="text-truncate truncate-small">@FormatTitleCase(template.Title)</td>
                            <td class="text-truncate truncate-big">@GetDescriptionPreview(template.Description)</td>
                            <td class="text-end">
                                <div class="table-row-actions">
                                    <ActionButton ButtonClass="outline-secondary" OnClick="() => NavigateToEdit(template.Id)" IconClass="oi oi-pencil"></ActionButton>
                                    <ActionButton ButtonClass="outline-danger btn-delete-soft" OnClick="() => NavigateToDelete(template.Id)" IconClass="oi oi-trash"></ActionButton>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (TotalPages > 1)
            {
                <Pagination CurrentPage="CurrentPage"
                            TotalPages="TotalPages"
                            SelectedPage="HandleSelectedPage"
                            PreviousPage="PreviousPage"
                            NextPage="NextPage"/>
            }
        }
    </div>
</div>

@code {
    private const int PageSize = 10;
    private IList<TherapyTemplate> therapyTemplates = [];
    private IList<TherapyTemplate> filteredTemplates = [];
    private IList<TherapyTemplate> DisplayedTemplates { get; set; } = [];
    private string CreationInlineMessage { get; set; } = string.Empty;
    private int CurrentPage { get; set; } = 1;
    private string SearchTerm { get; set; } = string.Empty;
    private int TotalPages => filteredTemplates.Count == 0 ? 1 : (int)Math.Ceiling((double)filteredTemplates.Count / PageSize);

    protected override async Task OnInitializedAsync()
    {
        await licenseService.InitializeAsync();
        CreationInlineMessage = await licenseService.GetTherapyTemplateCreationBlockMessageAsync() ?? string.Empty;
        therapyTemplates = await repository.GetAllOrderedAsync();
        await UpdateDisplayedTemplates();
    }

    private async Task SearchTemplates(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
        await UpdateDisplayedTemplates();
    }

    private async Task HandleSelectedPage(int page)
    {
        CurrentPage = page;
        await UpdateDisplayedTemplates();
    }

    private async Task PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await UpdateDisplayedTemplates();
        }
    }

    private async Task NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            await UpdateDisplayedTemplates();
        }
    }

    private async Task UpdateDisplayedTemplates()
    {
        await FilterTemplates();
        var startIndex = (CurrentPage - 1) * PageSize;
        DisplayedTemplates = filteredTemplates.Skip(startIndex).Take(PageSize).ToList();
    }

    private Task FilterTemplates()
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            filteredTemplates = therapyTemplates.ToList();
            return Task.CompletedTask;
        }

        var term = SearchTerm.Trim();
        filteredTemplates = therapyTemplates
            .Where(t =>
                (!string.IsNullOrWhiteSpace(t.Title) && t.Title.Contains(term, StringComparison.CurrentCultureIgnoreCase)) ||
                StringExtensions.ToPlainText(t.Description).Contains(term, StringComparison.CurrentCultureIgnoreCase))
            .ToList();

        return Task.CompletedTask;
    }

    private void NavigateToEdit(int id)
    {
        navigationManager.NavigateTo($"/therapy-template/{id}/edit");
    }

    private void NavigateToDelete(int id)
    {
        navigationManager.NavigateTo($"/therapy-template/{id}/delete");
    }

    private static string FormatTitleCase(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(
            value.ToLower(System.Globalization.CultureInfo.CurrentCulture));
    }

    private static string GetDescriptionPreview(string? description)
    {
        return StringExtensions.ToPlainText(description);
    }

}
