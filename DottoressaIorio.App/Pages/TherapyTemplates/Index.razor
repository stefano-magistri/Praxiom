@page "/therapy-templates"

@inject TherapyTemplateRepository repository
@inject NavigationManager navigationManager


<PageHeader Title="Terapie Precompilate" />

@if (therapyTemplates == null || therapyTemplates.Count == 0)
{
    <p>Nessuna terapia precompilata trovata.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Titolo</th>
                    <th>Descrizione</th>
                    <th>Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var template in therapyTemplates)
                {
                    <tr>
                        <td class="text-truncate truncate-small">@template.Title</td>
                        <td class="text-truncate truncate-big">
                            @template.Description
                        </td>
                        <td>
                            <ActionButton ButtonClass="primary" OnClick="() => NavigateToEdit(template.Id)" IconClass="oi oi-pencil"></ActionButton>
                            <ActionButton ButtonClass="danger" OnClick="() => NavigateToDelete(template.Id)" IconClass="oi oi-trash"></ActionButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IList<TherapyTemplate> therapyTemplates;

    protected override async Task OnInitializedAsync()
    {
        therapyTemplates = await repository.GetAllOrderedAsync();
    }

    private void NavigateToEdit(int id)
    {
        navigationManager.NavigateTo($"/therapy-template/{id}/edit");
    }

    private void NavigateToDelete(int id)
    {
        navigationManager.NavigateTo($"/therapy-template/{id}/delete");
    }
}