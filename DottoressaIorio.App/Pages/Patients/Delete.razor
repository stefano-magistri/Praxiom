@page "/patient/{id:int}/delete/"
@inject PatientRepository repository
@inject PatientTherapyRepository therapyRepository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager
 
<PageHeader Title="Rimuovi Paziente" /> 

<p>Vuoi rimuovere questo paziente?</p>
 
<CancelButton Url="@($"/patient/{Id}/")" /> 
<RemoveButton OnClick="@SaveAsync" />

@code {
    [Parameter]
    public int Id { get; set; }

    private Patient model;

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        await unitOfWork.ExecuteInTransactionAsync(async () =>
        {
            var therapies = await therapyRepository.GetAllAsync(Id);
            foreach (var therapy in therapies)
            {
                await therapyRepository.DeleteAsync(therapy);
            }

            await repository.DeleteAsync(model);
        });
        navigationManager.NavigateTo("/");
    }
}
