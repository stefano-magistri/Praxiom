@page "/patient/{id:int}/delete/"
@inject PatientRepository repository
@inject NavigationManager navigationManager

<PageTitle>Rimuovi Paziente</PageTitle>
<h1>Rimuovi Paziente</h1>
<hr class="my-4">

<p>Vuoi rimuovere questo paziente?</p>

<a class="btn btn-secondary" href="/patient/@Id">Annulla</a>
<button type="button" class="btn btn-danger" @onclick="@SaveAsync"><span class="oi oi-trash px-1" aria-hidden="true"></span>Rimuovi</button>

@code {
    [Parameter]
    public int Id { get; set; }

    private Patient model;

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        await repository.DeleteAsync(model);
        navigationManager.NavigateTo("/patients");
    }
}