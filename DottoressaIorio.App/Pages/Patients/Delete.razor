@page "/patient/{id:int}/delete/"
@inject PatientRepository repository
@inject PatientTherapyRepository therapyRepository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager

<ActionPageHeader Title="Rimuovi Paziente" Subtitle="@FormattedPatientName"/>

<ConfirmDeleteSection ConfirmationText="Vuoi rimuovere questo paziente?"
                      CancelUrl="@($"/patient/{Id}/")"
                      OnConfirm="@SaveAsync"/>

@code {
    [Parameter] public int Id { get; set; }

    private Patient model;
    private string FormattedPatientName => model == null
        ? string.Empty
        : FormatFullName(model.FirstName, model.LastName);

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        await unitOfWork.ExecuteInTransactionAsync(async () =>
        {
            var therapies = await therapyRepository.GetAllAsync(Id);
            foreach (var therapy in therapies)
            {
                await therapyRepository.DeleteAsync(therapy);
            }

            await repository.DeleteAsync(model);
        });
        navigationManager.NavigateTo("/");
    }

    private static string FormatFullName(string? firstName, string? lastName)
    {
        var fullName = $"{firstName ?? string.Empty} {lastName ?? string.Empty}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return string.Empty;
        }

        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(
            fullName.ToLower(System.Globalization.CultureInfo.CurrentCulture));
    }

}
