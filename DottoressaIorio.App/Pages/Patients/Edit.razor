@page "/patient/{id:int}/edit/"
@inject PatientRepository repository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager
@inject DottoressaIorio.Services.Backup.IOnlineBackupService onlineBackupService

<ActionPageHeader Title="Modifica Paziente" Subtitle="@FormattedPatientName"/>
@if (model == null)
{
    <p>ID paziente non valido o paziente non trovato.</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="@SaveAsync" class="needs-validation" novalidate>
        <DataAnnotationsValidator/>
        <ValidationWarningAlert Message="@warningMessage"/>
        <div class="row g-3">
            <div class="col-12">
                <label for="Title">Titolo</label>
                <select id="Title" @bind="model.Title" class="form-select">
                    <option value="" selected>Seleziona...</option>
                    <option value="Sig.re">Signore</option>
                    <option value="Sig.ra">Signora</option>
                    <option value="Dott.">Dottore</option>
                    <option value="Dott.ssa">Dottoressa</option>
                    <option value="Proff.">Professore</option>
                    <option value="Proff.essa">Professoressa</option>
                </select>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-12">
                <label>Nome:*</label>
                <InputText id="FirstName" @bind-Value="model.FirstName" class="form-control" autocomplete="off"/>
                <ValidationMessage For="@(() => model.FirstName)"/>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-12">
                <label>Cognome:*</label>
                <InputText id="LastName" @bind-Value="model.LastName" class="form-control" autocomplete="off"/>
                <ValidationMessage For="@(() => model.LastName)"/>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-12">
                <label>Data di Nascita (es: 31/12/1979):*</label>
                <input type="date" class="form-control" @bind="model.DateOfBirth"/>
                <ValidationMessage For="@(() => model.DateOfBirth)"/>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-12">
                <label>Luogo di Nascita:</label>
                <InputText id="PlaceOfBirth" @bind-Value="model.PlaceOfBirth" class="form-control" autocomplete="off"/>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-12">
                <label>Sesso:</label>
                <div class="form-check form-check-inline">
                    <input type="radio" checked="@(model.Gender == "Maschio")"
                           name="Gender" @onchange="@(() => model.Gender = "Maschio")"/>
                    <label class="form-check-label" for="genderMale">Maschio</label>
                </div>
                <div class="form-check form-check-inline">
                    <input type="radio" checked="@(model.Gender == "Femmina")"
                           name="Gender" @onchange="@(() => model.Gender = "Femmina")"/>
                    <label class="form-check-label" for="genderFemale">Femmina</label>
                </div>
                <div class="form-check form-check-inline">
                    <input type="radio" checked="@(model.Gender == "Altro")"
                           name="Gender" @onchange="@(() => model.Gender = "Altro")"/>
                    <label class="form-check-label" for="genderFemale">Altro</label>
                </div>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-12">
                <label>Numero di telefono:</label>
                <input type="tel" class="form-control" @bind="model.PhoneNumber">
                <ValidationMessage For="@(() => model.PhoneNumber)"/>
            </div>
        </div>
        <div class="form-group">
            <label>Indirizzo email:</label>
            <input type="email" class="form-control" @bind="model.Email" placeholder="name@example.com"/>
            <ValidationMessage For="@(() => model.Email)"/>
        </div>
        <hr class="my-4">
        <div class="row g-3">
            <div class="col-12">
                <label for="Notes">Note:</label>
                <InputTextArea id="Notes" @bind-Value="model.Notes" class="form-control"/>
            </div>
        </div>
        <hr class="my-4">
        <CancelButton Url="@($"/patient/{Id}/")"/>
        <AnchorButton ButtonText="Rimuovi" ButtonClass="outline-danger btn-delete-soft" Url="@($"/patient/{Id}/delete/")"></AnchorButton>
        <SubmitButton/>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private Patient? model;
    private string warningMessage = "";
    private string FormattedPatientName => model == null
        ? string.Empty
        : FormatFullName(model.FirstName, model.LastName);

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        try
        {
            if (model is null)
            {
                navigationManager.NavigateTo("/");
                return;
            }

            await repository.UpdateAsync(model);
            await unitOfWork.SaveChangesAsync();
            try
            {
                await onlineBackupService.TriggerBackupAsync("patient-update");
            }
            catch
            {
                // Backup failures must not block the user save flow.
            }

            navigationManager.NavigateTo($"/patient/{Id}/");
        }
        catch (Exception ex)
        {
            warningMessage = ValidationExceptionMapper.ToUserMessage(ex);
        }
    }

    private static string FormatFullName(string? firstName, string? lastName)
    {
        var fullName = $"{firstName ?? string.Empty} {lastName ?? string.Empty}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return string.Empty;
        }

        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(
            fullName.ToLower(System.Globalization.CultureInfo.CurrentCulture));
    }

}

