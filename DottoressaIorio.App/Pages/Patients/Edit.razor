@page "/patient/{id:int}/edit/"
@inject PatientRepository repository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager
@inject DottoressaIorio.Services.Backup.IOnlineBackupService onlineBackupService

<ActionPageHeader Title="Modifica paziente"/>
@if (model == null)
{
    <p>ID paziente non valido o paziente non trovato.</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="@SaveAsync" class="needs-validation" novalidate>
        <DataAnnotationsValidator/>
        <ValidationWarningAlert Message="@warningMessage"/>
        <div class="row g-3 patient-form-grid">
            <div class="col-12 col-lg-6">
                <label>Nome:*</label>
                <InputText id="FirstName" @bind-Value="model.FirstName" class="form-control" autocomplete="off"/>
                <ValidationMessage For="@(() => model.FirstName)"/>
            </div>
            <div class="col-12 col-lg-6">
                <label>Cognome:*</label>
                <InputText id="LastName" @bind-Value="model.LastName" class="form-control" autocomplete="off"/>
                <ValidationMessage For="@(() => model.LastName)"/>
            </div>
            <div class="col-12 col-lg-6">
                <label for="DateOfBirth">Data di Nascita (es: 31/12/1979):*</label>
                <input id="DateOfBirth" type="date" class="form-control" @bind="model.DateOfBirth"/>
                <ValidationMessage For="@(() => model.DateOfBirth)"/>
            </div>
            <div class="col-12 col-lg-6">
                <label for="Email">Indirizzo email:</label>
                <input id="Email" type="email" class="form-control" @bind="model.Email" placeholder="name@example.com"/>
                <ValidationMessage For="@(() => model.Email)"/>
            </div>
            <div class="col-12 col-lg-6">
                <label for="Title">Titolo</label>
                <select id="Title" @bind="model.Title" class="form-select">
                    <option value="" selected>Seleziona...</option>
                    <option value="Sig.re">Signore</option>
                    <option value="Sig.ra">Signora</option>
                    <option value="Dott.">Dottore</option>
                    <option value="Dott.ssa">Dottoressa</option>
                    <option value="Proff.">Professore</option>
                    <option value="Proff.essa">Professoressa</option>
                </select>
            </div>
            <div class="col-12 col-lg-6">
                <label for="PlaceOfBirth">Luogo di Nascita:</label>
                <InputText id="PlaceOfBirth" @bind-Value="model.PlaceOfBirth" class="form-control" autocomplete="off"/>
            </div>
            <div class="col-12 col-lg-6">
                <label>Sesso:</label>
                <div class="patient-gender-group">
                    <div class="form-check form-check-inline">
                        <input id="GenderMale" type="radio" checked="@(model.Gender == "Maschio")"
                               name="Gender" @onchange="@(() => model.Gender = "Maschio")"/>
                        <label class="form-check-label" for="GenderMale">Maschio</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input id="GenderFemale" type="radio" checked="@(model.Gender == "Femmina")"
                               name="Gender" @onchange="@(() => model.Gender = "Femmina")"/>
                        <label class="form-check-label" for="GenderFemale">Femmina</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input id="GenderOther" type="radio" checked="@(model.Gender == "Altro")"
                               name="Gender" @onchange="@(() => model.Gender = "Altro")"/>
                        <label class="form-check-label" for="GenderOther">Altro</label>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <label for="PhoneNumber">Numero di telefono:</label>
                <input id="PhoneNumber" type="tel" class="form-control" @bind="model.PhoneNumber">
                <ValidationMessage For="@(() => model.PhoneNumber)"/>
            </div>
            <div class="col-12">
                <label for="Notes">Note:</label>
                <InputTextArea id="Notes" @bind-Value="model.Notes" class="form-control patient-notes-input" rows="4"/>
            </div>
        </div>
        <StandardFormActions CancelUrl="@($"/patient/{Id}/")"
                             RemoveUrl="@($"/patient/{Id}/delete/")"/>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private Patient model;
    private string warningMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        try
        {
            await repository.UpdateAsync(model);
            await unitOfWork.SaveChangesAsync();
            try
            {
                await onlineBackupService.TriggerBackupAsync("patient-update");
            }
            catch
            {
                // Backup failures must not block the user save flow.
            }

            navigationManager.NavigateTo($"/patient/{Id}/");
        }
        catch (Exception ex)
        {
            warningMessage = ValidationExceptionMapper.ToUserMessage(ex);
        }
    }

}

