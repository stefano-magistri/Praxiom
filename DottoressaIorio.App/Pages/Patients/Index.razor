@page "/patients"
@inherits PatientsBase
 
<PageHeader Title="Pazienti" /> 

<div class="mb-3">
    <label for="search" class="form-label">Cerca il paziente <i>(nome, cognome or entrambi):</i></label>
    <input type="text" class="form-control" id="search" @bind="SearchTerm" @oninput="SearchPatients" autocomplete="off" />
</div>

@if (DisplayedPatients == null || DisplayedPatients.Count == 0)
{
    <hr class="my-4">
    <p>Nessun paziente trovato.</p>
}
else
{
    <Pagination CurrentPage="CurrentPage"
                TotalPages="TotalPages"
                SelectedPage="HandleSelectedPage"
                PreviousPage="PreviousPage"
                NextPage="NextPage" />
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Paziente</th>
                    <th>Data di Nascita</th>
                    <th>Visitato</th>
                    <th>Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in DisplayedPatients)
                {
                    <tr>
                        <td>
                            <span class="oi oi-eye px-2" aria-hidden="true"></span>
                            <a href="/patient/@patient.PatientId/">@patient.Title @patient.FirstName @patient.LastName</a>
                        </td>
                        <td>
                            @patient.DateOfBirth?.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @patient.CreatedDate.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <ActionButton ButtonClass="primary" OnClick="() => NavigateToEditPatient(patient.PatientId)" IconClass="oi oi-pencil"></ActionButton>
                            <ActionButton ButtonClass="danger" OnClick="() => NavigateToDeletePatient(patient.PatientId)" IconClass="oi oi-trash"></ActionButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pagination CurrentPage="CurrentPage"
                TotalPages="TotalPages"
                SelectedPage="HandleSelectedPage"
                PreviousPage="PreviousPage"
                NextPage="NextPage" />
}