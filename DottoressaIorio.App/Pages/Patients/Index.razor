@using DottoressaIorio.App.Helpers
@page "/"
@inherits PatientsBase

<PageHeader Title="Pazienti"/>

<div class="card patients-card" data-testid="patients-page">
    <div class="card-body p-4">
        <div class="patients-toolbar mb-3">
            <div class="patients-toolbar-search">
                <SearchBox Id="search"
                           Name="search"
                           Value="@SearchTerm"
                           OnInput="SearchPatients"
                           AutoFocus="true"
                           Placeholder="Cerca paziente per nome o cognome..."/>
            </div>
            <div class="patients-toolbar-actions">
                @if (LicenseService.IsTrialExpired)
                {
                    <button class="btn btn-primary"
                            data-testid="create-patient-page-link"
                            type="button"
                            title="Nuovo Paziente"
                            aria-label="Nuovo Paziente"
                            disabled>
                        <span class="oi oi-plus px-1" aria-hidden="true"></span>Nuovo Paziente
                    </button>
                }
                else
                {
                    <a class="btn btn-primary"
                       data-testid="create-patient-page-link"
                       href="/create-patient"
                       title="Nuovo Paziente"
                       aria-label="Nuovo Paziente">
                        <span class="oi oi-plus px-1" aria-hidden="true"></span>Nuovo Paziente
                    </a>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(CreationInlineMessage))
        {
            <p class="trial-inline-message">@CreationInlineMessage</p>
        }

        @if (DisplayedPatients == null || DisplayedPatients.Count == 0)
        {
            <p class="mb-0">Nessun paziente trovato.</p>
        }
        else
        {
            @if (TotalPages > 1)
            {
                <Pagination CurrentPage="CurrentPage"
                            TotalPages="TotalPages"
                            SelectedPage="HandleSelectedPage"
                            PreviousPage="PreviousPage"
                            NextPage="NextPage"/>
            }

            <div class="table-responsive patients-table-wrapper">
                <table class="table table-sm table-hover align-middle mb-0 patients-table">
                    <thead>
                    <tr>
                        <th>Paziente</th>
                        <th>Età</th>
                        <th>ULTIMA VISITA</th>
                        <th class="text-end">Azioni</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var patient in DisplayedPatients)
                    {
                        <tr class="patient-row"
                            @onclick="() => NavigateToPatient(patient.PatientId)"
                            tabindex="0"
                            role="link"
                            @onkeydown="args => HandlePatientRowKeyDown(args, patient.PatientId)">
                            <td>
                                <a class="patient-link" href="/patient/@patient.PatientId/">@patient.Title @FormatPatientDisplayName(patient.FirstName, patient.LastName)</a>
                            </td>
                            <td>
                                @{
                                    var patientAge = GetPatientAge(patient.DateOfBirth);
                                }
                                @if (patientAge.HasValue && patient.DateOfBirth.HasValue)
                                {
                                    @patientAge
                                    <small class="text-muted d-block patient-last-visit-relative">(@patient.DateOfBirth.Value.ToString("yyyy"))</small>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                @{
                                    var lastVisit = GetLastVisitDate(patient);
                                }
                                @lastVisit?.ToString("dd/MM/yyyy")
                                @if (lastVisit.HasValue)
                                {
                                    <small class="text-muted d-block patient-last-visit-relative">(@DateFormatting.ToRelativeItalian(lastVisit))</small>
                                }
                            </td>
                            <td class="text-end" @onclick:stopPropagation="true">
                                <div class="patient-row-actions">
                                    <a class="btn btn-primary"
                                       href="@(!LicenseService.IsTrialExpired ? $"/patient/{patient.PatientId}/create-therapy/" : null)"
                                       title="Nuova terapia"
                                       aria-label="Nuova terapia"
                                       @onclick:preventDefault="LicenseService.IsTrialExpired"
                                       aria-disabled="@LicenseService.IsTrialExpired">
                                        <span class="oi oi-document px-1" aria-hidden="true"></span>Nuova terapia
                                    </a>
                                    <ActionButton ButtonClass="outline-secondary patient-row-action-compact"
                                                  ButtonText=""
                                                  Title="Modifica"
                                                  AriaLabel="Modifica"
                                                  OnClick="() => NavigateToEditPatient(patient.PatientId)"
                                                  IconClass="oi oi-pencil"></ActionButton>
                                    <ActionButton ButtonClass="outline-danger btn-delete-soft patient-row-action-compact"
                                                  ButtonText=""
                                                  Title="Elimina"
                                                  AriaLabel="Elimina"
                                                  OnClick="() => NavigateToDeletePatient(patient.PatientId)"
                                                  IconClass="oi oi-trash"></ActionButton>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (TotalPages > 1)
            {
                <Pagination CurrentPage="CurrentPage"
                            TotalPages="TotalPages"
                            SelectedPage="HandleSelectedPage"
                            PreviousPage="PreviousPage"
                            NextPage="NextPage"/>
            }

            <div class="patients-utility-row">
                <div class="patients-export-panel">
                    <button class="btn btn-outline-primary patients-export-button"
                            data-testid="export-csv-link"
                            type="button"
                            title="Esporta CSV"
                            aria-label="Esporta CSV"
                            @onclick="ExportCsvAsync">
                        <span class="oi oi-data-transfer-download px-1" aria-hidden="true"></span>Esporta CSV
                    </button>
                    <p class="patients-export-hint mb-0">Esporta CSV con i filtri attivi.</p>
                </div>
            </div>
        }
    </div>
</div>
