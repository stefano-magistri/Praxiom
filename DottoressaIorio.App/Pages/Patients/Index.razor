@page "/"
@inherits PatientsBase

<PageHeader Title="Pazienti"/>

<p class="patients-subtitle">Ricerca un paziente e crea subito una nuova terapia.</p>

<div class="card patients-card" data-testid="patients-page">
    <div class="card-body p-4">
        <SearchBox Id="search"
                   Label="Cerca paziente"
                   Value="@SearchTerm"
                   OnInput="SearchPatients"
                   Placeholder="Cerca per nome, cognome o entrambi"/>

        @if (DisplayedPatients == null || DisplayedPatients.Count == 0)
        {
            <p class="mb-0">Nessun paziente trovato.</p>
        }
        else
        {
            @if (TotalPages > 1)
            {
                <Pagination CurrentPage="CurrentPage"
                            TotalPages="TotalPages"
                            SelectedPage="HandleSelectedPage"
                            PreviousPage="PreviousPage"
                            NextPage="NextPage"/>
            }

            <div class="table-responsive patients-table-wrapper">
                <table class="table table-sm table-hover align-middle mb-0 patients-table">
                    <thead>
                    <tr>
                        <th>Paziente</th>
                        <th>Data di Nascita</th>
                        <th>Visitato</th>
                        <th class="text-end">Azioni</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var patient in DisplayedPatients)
                    {
                        <tr>
                            <td>
                                <span class="oi oi-eye px-2 text-muted" aria-hidden="true"></span>
                                <a class="patient-link" href="/patient/@patient.PatientId/">@patient.Title @patient.FirstName @patient.LastName</a>
                            </td>
                            <td>
                                @patient.DateOfBirth?.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @patient.CreatedDate.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-end">
                                <div class="patient-row-actions">
                                    <AnchorButton ButtonClass="primary btn-create-therapy" Url="@($"/patient/{patient.PatientId}/create-therapy/")" IconClass="oi oi-plus" ButtonText="Crea terapia"></AnchorButton>
                                    <ActionButton ButtonClass="outline-secondary" OnClick="() => NavigateToEditPatient(patient.PatientId)" IconClass="oi oi-pencil"></ActionButton>
                                    <ActionButton ButtonClass="outline-danger btn-delete-soft" OnClick="() => NavigateToDeletePatient(patient.PatientId)" IconClass="oi oi-trash"></ActionButton>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (TotalPages > 1)
            {
                <Pagination CurrentPage="CurrentPage"
                            TotalPages="TotalPages"
                            SelectedPage="HandleSelectedPage"
                            PreviousPage="PreviousPage"
                            NextPage="NextPage"/>
            }
        }
    </div>
</div>
