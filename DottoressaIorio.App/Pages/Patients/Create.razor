@page "/create-patient"
@inject PatientRepository repository 
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager
@inject DottoressaIorio.Services.Backup.IOnlineBackupService onlineBackupService
@inject ILicenseService licenseService

<PageHeader Title="Nuovo Paziente"/>

<EditForm Model="@model" OnValidSubmit="@SaveAsync" class="needs-validation" novalidate>
    <DataAnnotationsValidator/>
    <ValidationWarningAlert Message="@warningMessage"/>
    @if (licenseService.IsTrialExpired)
    {
        <div class="alert alert-danger" role="alert">@TrialExpiredMessage</div>
    }
    <div class="row g-3">
        <div class="col-12">
            <label for="FirstName">Nome:*</label>
            <input id="FirstName" type="text" class="form-control" @bind="model.FirstName" autocomplete="off"/>
            <ValidationMessage For="@(() => model.FirstName)"/>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-12">
            <label for="LastName">Cognome:*</label>
            <input id="LastName" type="text" class="form-control" @bind="model.LastName" autocomplete="off">
            <ValidationMessage For="@(() => model.LastName)"/>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-12">
            <label for="DateOfBirth">Data di Nascita (es: 31/12/1979):*</label>
            <input id="DateOfBirth" type="date" class="form-control" @bind="model.DateOfBirth" autocomplete="off"/>
            <ValidationMessage For="@(() => model.DateOfBirth)"/>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-12">
            <label for="Email">Indirizzo email:</label>
            <input id="Email" type="email" class="form-control" @bind="model.Email" placeholder="name@example.com" autocomplete="off"/>
            <ValidationMessage For="@(() => model.Email)"/>
        </div>
    </div>
    <hr class="my-4">
    <CancelButton Url="/"/>
    <SubmitButton Disabled="@licenseService.IsTrialExpired"/>
</EditForm>

@code {
    private const string TrialExpiredMessage =
        "Periodo di prova scaduto. Inserire una licenza per continuare ad utilizzare il software.";
    private readonly Patient model = new();
    private string warningMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await licenseService.InitializeAsync();
    }

    private async Task SaveAsync()
    {
        var trialMessage = await licenseService.GetPatientCreationBlockMessageAsync();
        if (!string.IsNullOrWhiteSpace(trialMessage))
        {
            warningMessage = trialMessage;
            return;
        }

        // Check if the title already exists
        if (string.IsNullOrEmpty(warningMessage) && await repository.PatientExistsAsync(model))
        {
            warningMessage = "Il paziente giá esiste. Sei sicura di voler continuare?";
            return;
        }

        try
        {
            await repository.AddAsync(model);
            await unitOfWork.SaveChangesAsync();
            try
            {
                await onlineBackupService.TriggerBackupAsync("patient-create");
            }
            catch
            {
                // Backup failures must not block the user save flow.
            }

            navigationManager.NavigateTo($"/patient/{model.PatientId}/");
        }
        catch (Exception ex)
        {
            warningMessage = ValidationExceptionMapper.ToUserMessage(ex);
        }
    }

}

