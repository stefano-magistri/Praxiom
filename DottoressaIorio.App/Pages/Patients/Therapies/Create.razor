@page "/patient/{id:int}/create-therapy"

@inject TherapyTemplateRepository templateRepository
@inject PatientTherapyRepository repository
@inject PatientRepository patientRepository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager
@inject DottoressaIorio.Services.Backup.IOnlineBackupService onlineBackupService
@using DottoressaIorio.Services.Therapies
@using Microsoft.AspNetCore.Components

<ActionPageHeader Title="Nuova Terapia"/>

<div class="therapy-editor-shell">
    <PatientContextCard Patient="patient" ShowHeaderName="true"/>

    <EditForm Model="@model" OnValidSubmit="@SaveAsync" class="needs-validation therapy-editor-form" novalidate>
        <DataAnnotationsValidator/>
        <ValidationWarningAlert Message="@warningMessage"/>
        <div class="row g-3">
            <div class="col-12">
                <label for="TemplateId">Precompilato:</label>
                <select id="TemplateId" value="@selectedTemplateId" @onchange="TemplateChanged" class="form-select">
                    <option value="0">Seleziona...</option>
                    @foreach (var template in templates)
                    {
                        <option value="@template.Id">@template.Title</option>
                    }
                </select>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-12">
                <label for="Description">Descrizione:</label>
                <InputTextArea id="Description" @bind-Value="model.Description" class="form-control therapy-description-field"/>
                <ValidationMessage For="@(() => model.Description)"/>
            </div>
        </div>
        <hr class="my-4">
        <div class="therapy-editor-actions">
            <CancelButton Url="@($"/patient/{Id}/")"/>
            <SubmitButton/>
        </div>
    </EditForm>
</div>

@if (showTemplateConflictDialog)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="templateConflictTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="templateConflictTitle" class="modal-title">Sostituire il testo esistente oppure aggiungerlo?</h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="ConfirmTemplateReplace">Sostituisci</button>
                    <button type="button" class="btn btn-outline-primary" @onclick="ConfirmTemplateAppend">Aggiungi</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelTemplateChange">Annulla</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Patient? patient;
    [SupplyParameterFromQuery(Name = "duplicateFrom")] public int? DuplicateFromTherapyId { get; set; }

    private Therapy model = new();
    private IList<TherapyTemplate> templates = [];
    private string warningMessage = "";
    private int selectedTemplateId;
    private int appliedTemplateId;
    private int? loadedDuplicateTherapyId;
    private bool showTemplateConflictDialog;
    private int pendingTemplateId;
    private string pendingTemplateDescription = string.Empty;
    private string FormattedPatientName => patient == null
        ? string.Empty
        : FormatFullName(patient.FirstName, patient.LastName);

    protected override async Task OnInitializedAsync()
    {
        templates = await templateRepository.GetAllOrderedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        patient = await patientRepository.GetByIdAsync(Id);

        if (DuplicateFromTherapyId.HasValue && DuplicateFromTherapyId != loadedDuplicateTherapyId)
        {
            var sourceTherapy = await repository.GetByIdAsync(DuplicateFromTherapyId.Value);
            if (sourceTherapy != null && sourceTherapy.PatientId == Id)
            {
                model = TherapyDraftService.CreateDuplicate(sourceTherapy, DateTime.Today);
                loadedDuplicateTherapyId = DuplicateFromTherapyId;
            }
        }

        model.PatientId = Id;
    }

    private async Task SaveAsync()
    {
        try
        {
            model.PatientId = Id;
            await repository.AddAsync(model);
            await unitOfWork.SaveChangesAsync();
            try
            {
                await onlineBackupService.TriggerBackupAsync("therapy-create");
            }
            catch
            {
                // Backup failures must not block the user save flow.
            }

            navigationManager.NavigateTo($"/patient/{Id}");
        }
        catch (Exception ex)
        {
            warningMessage = ValidationExceptionMapper.ToUserMessage(ex);
        }
    }

    private async Task TemplateChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var id) || id <= 0)
        {
            selectedTemplateId = 0;
            appliedTemplateId = 0;
            model.Description = string.Empty;
            return;
        }

        var selected = await templateRepository.GetByIdAsync(id);
        if (selected == null)
        {
            selectedTemplateId = appliedTemplateId;
            return;
        }

        selectedTemplateId = id;
        var templateDescription = selected.Description ?? string.Empty;
        if (string.IsNullOrWhiteSpace(model.Description))
        {
            model.Description = templateDescription;
            appliedTemplateId = id;
            return;
        }

        pendingTemplateId = id;
        pendingTemplateDescription = templateDescription;
        showTemplateConflictDialog = true;
    }

    private Task ConfirmTemplateReplace()
    {
        model.Description = TherapyDraftService.ApplyTemplate(
            model.Description,
            pendingTemplateDescription,
            TherapyTemplateApplyMode.Replace);
        appliedTemplateId = pendingTemplateId;
        showTemplateConflictDialog = false;
        return Task.CompletedTask;
    }

    private Task ConfirmTemplateAppend()
    {
        model.Description = TherapyDraftService.ApplyTemplate(
            model.Description,
            pendingTemplateDescription,
            TherapyTemplateApplyMode.Append);
        appliedTemplateId = pendingTemplateId;
        showTemplateConflictDialog = false;
        return Task.CompletedTask;
    }

    private Task CancelTemplateChange()
    {
        selectedTemplateId = appliedTemplateId;
        pendingTemplateId = 0;
        pendingTemplateDescription = string.Empty;
        showTemplateConflictDialog = false;
        return Task.CompletedTask;
    }

    private static string FormatFullName(string? firstName, string? lastName)
    {
        var fullName = $"{firstName ?? string.Empty} {lastName ?? string.Empty}".Trim();
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return string.Empty;
        }

        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(
            fullName.ToLower(System.Globalization.CultureInfo.CurrentCulture));
    }

}

