@page "/patient/{patientId:int}/"

@inject PatientRepository patientRepository
@inject PatientTherapyRepository repository
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime
@inject PdfService pdfService

@if (patient == null)
{
    <p>ID paziente non valido o paziente non trovato.</p>
}
else
{
    <PageHeader Title="@($"{patient.Title} {patient.FirstName} {patient.LastName}")"></PageHeader>

    <div>
        <p>
            <strong>Data di Nascita:</strong> @patient.DateOfBirth?.ToShortDateString()
        </p>
        @if (!string.IsNullOrEmpty(patient.Email))
        {
            <p>
                <strong>Email:</strong> <a href="mailto:@patient.Email">@patient.Email</a>
            </p>
        }
        @if (patient.PlaceOfBirth != null)
        {
            <p>
                <strong>Luogo di Nascita:</strong> @patient.PlaceOfBirth
            </p>
        }
        @if (patient.Gender != null)
        {
            <p>
                <strong>Sesso:</strong> @patient.Gender
            </p>
        }
        @if (patient.PhoneNumber != null)
        {
            <p>
                <strong>Numero di telefono:</strong> <a href="tel:@patient.PhoneNumber">@patient.PhoneNumber</a>
            </p>
        }
    </div>

    <hr class="my-4">
    <h3>Note</h3>


    @if (!string.IsNullOrEmpty(patient.Notes))
    {
        <p>
            @((MarkupString)patient.GetHtmlNotes())
        </p>
    }
    else
    {
        <p>
            Non ci sono note.
        </p>
    }

    <hr class="my-4">
    <AnchorButton ButtonClass="primary" Url="@($"/patient/{PatientId}/edit/")" IconClass="oi oi-pencil" ButtonText="Modifica"></AnchorButton>
    <AnchorButton ButtonClass="danger" Url="@($"/patient/{PatientId}/delete/")" IconClass="oi oi-trash" ButtonText="Rimuovi"></AnchorButton>

    <hr class="my-4">
    <h3>Terapie</h3>

    <AnchorButton ButtonClass="outline-primary" Url="@($"/patient/{PatientId}/create-therapy/")" IconClass="oi oi-plus" ButtonText="Aggiungi"></AnchorButton>
    
    @if (therapies != null && therapies.Any())
    {
        <hr class="my-4">
        <table class="table">
            <thead>
                <tr>
                    <th>Data inizio terapia</th>
                    <th>Descrizione</th>
                    <th>Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in therapies)
                {
                    <tr>
                        <td>
                            @t.CreatedDate.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-truncate truncate-small">
                            @t.Description
                        </td>
                        <td> 
                            <ActionButton ButtonClass="dark" OnClick="() => PrintAsync(t.TherapyId)" IconClass="oi oi-data-transfer-download"></ActionButton>
                            <ActionButton ButtonClass="primary" OnClick="() => NavigateToEditTherapy(t.TherapyId)" IconClass="oi oi-pencil"></ActionButton>
                            <ActionButton ButtonClass="danger" OnClick="() => NavigateToDeleteTherapy(t.TherapyId)" IconClass="oi oi-trash"></ActionButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private Patient patient;

    [Parameter] public int PatientId { get; set; }
    private IList<Therapy> therapies;


    protected override async Task OnParametersSetAsync()
    {
        patient = await patientRepository.GetByIdAsync(PatientId);
        therapies = await repository.GetAllsync(PatientId);
    }

    private async Task PrintAsync(int id)
    {
        var therapy = await repository.GetByIdAsync(id);
        var pdfBytes = pdfService.GenerateTherapyPdf(therapy);
        // Convert the PDF bytes to a Base64 string
        var pdfBase64 = Convert.ToBase64String(pdfBytes);
        var filename = $"{patient.FirstName}_{patient.LastName}_{therapy.CreatedDate:yy_MM_dd}_{DateTime.Now.ToFileTimeUtc()}.pdf";
        // Open the PDF in a new tab
        await jsRuntime.InvokeVoidAsync("jsSaveAsFile", filename, pdfBase64);
    }
    
    private void NavigateToDeleteTherapy(int id)
    {
        navigationManager.NavigateTo($"/patient/{id}/delete-therapy/");
    }
    private void NavigateToEditTherapy(int id)
    {
        navigationManager.NavigateTo($"/patient/{id}/edit-therapy/");
    }

}
