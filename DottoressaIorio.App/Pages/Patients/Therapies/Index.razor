@page "/patient/{patientId:int}/"
@using DottoressaIorio.Services.Pdf

@inject PatientRepository patientRepository
@inject PatientTherapyRepository repository
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime
@inject PdfService pdfService

<PageHeader Title="@PatientPageTitle"></PageHeader>

@if (patient == null)
{
    <p>ID paziente non valido o paziente non trovato.</p>
}
else
{
    <div class="card patient-summary-card mb-4">
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-12 col-lg-6">
                    <dl class="row mb-0 patient-summary-list">
                        <dt class="col-sm-5">Data di nascita</dt>
                        <dd class="col-sm-7">@patient.DateOfBirth?.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-5">Numero di telefono</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(patient.PhoneNumber))
                            {
                                <a href="tel:@patient.PhoneNumber">@patient.PhoneNumber</a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Email</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrWhiteSpace(patient.Email))
                            {
                                <a href="mailto:@patient.Email">@patient.Email</a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </dd>
                    </dl>
                </div>

                <div class="col-12 col-lg-6">
                    <dl class="row mb-0 patient-summary-list">
                        <dt class="col-sm-5">Luogo di nascita</dt>
                        <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(patient.PlaceOfBirth) ? "-" : patient.PlaceOfBirth)</dd>

                        <dt class="col-sm-5">Sesso</dt>
                        <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(patient.Gender) ? "-" : patient.Gender)</dd>

                        <dt class="col-sm-5">Note</dt>
                        <dd class="col-sm-7 patient-notes">
                            @(string.IsNullOrWhiteSpace(patient.Notes) ? "Nessuna nota" : patient.Notes)
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="patient-action-row mt-4">
                <AnchorButton ButtonClass="primary" Url="@($"/patient/{PatientId}/edit/")" IconClass="oi oi-pencil" ButtonText="Modifica"></AnchorButton>
                <AnchorButton ButtonClass="outline-danger btn-delete-soft" Url="@($"/patient/{PatientId}/delete/")" IconClass="oi oi-trash" ButtonText="Rimuovi"></AnchorButton>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="mb-0">Terapie</h3>
        <AnchorButton ButtonClass="primary btn-create-therapy" Url="@($"/patient/{PatientId}/create-therapy/")" IconClass="oi oi-plus" ButtonText="Nuova Terapia"></AnchorButton>
    </div>

    <div class="card therapies-card">
        <div class="card-body p-4">
            @if (LatestTherapy != null)
            {
                <div class="therapy-top-actions mb-3">
                    <button type="button" class="btn btn-outline-primary" @onclick="() => PrintAsync(LatestTherapy.TherapyId)">
                        <span class="oi oi-data-transfer-download px-1" aria-hidden="true"></span>Scarica ultima terapia
                    </button>
                </div>
            }

            <div class="mb-3">
                <label for="therapySearch" class="form-label">Cerca terapia</label>
                <input id="therapySearch"
                       type="text"
                       class="form-control"
                       value="@TherapySearchTerm"
                       @oninput="SearchTherapies"
                       placeholder="Cerca nella descrizione o per data (gg/MM/aaaa)"
                       autocomplete="off" />
            </div>

            @if (DisplayedTherapies.Any())
            {
                @if (TherapyTotalPages > 1)
                {
                    <Pagination CurrentPage="TherapyCurrentPage"
                                TotalPages="TherapyTotalPages"
                                SelectedPage="HandleTherapySelectedPage"
                                PreviousPage="PreviousTherapyPage"
                                NextPage="NextTherapyPage" />
                }

                <div class="table-responsive patients-table-wrapper mt-0 mb-0">
                    <table class="table table-sm align-middle mb-0 patients-table">
                        <thead>
                            <tr>
                                <th>Data inizio terapia</th>
                                <th>Descrizione</th>
                                <th class="text-end">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in DisplayedTherapies)
                            {
                                <tr>
                                    <td>@t.CreatedDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-truncate truncate-small">@t.Description</td>
                                    <td class="text-end">
                                        <div class="table-row-actions">
                                            <ActionButton ButtonClass="primary" ButtonText="PDF" OnClick="() => PrintAsync(t.TherapyId)" IconClass="oi oi-data-transfer-download"></ActionButton>
                                            <ActionButton ButtonClass="outline-secondary" OnClick="() => NavigateToEditTherapy(t.TherapyId)" IconClass="oi oi-pencil"></ActionButton>
                                            <ActionButton ButtonClass="outline-danger btn-delete-soft" OnClick="() => NavigateToDeleteTherapy(t.TherapyId)" IconClass="oi oi-trash"></ActionButton>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (TherapyTotalPages > 1)
                {
                    <Pagination CurrentPage="TherapyCurrentPage"
                                TotalPages="TherapyTotalPages"
                                SelectedPage="HandleTherapySelectedPage"
                                PreviousPage="PreviousTherapyPage"
                                NextPage="NextTherapyPage" />
                }
            }
            else
            {
                <p class="mb-0">Nessuna terapia trovata.</p>
            }
        </div>
    </div>
}

@code {
    private Patient? patient;

    [Parameter] public int PatientId { get; set; }
    private IList<Therapy> allTherapies = [];
    private IList<Therapy> filteredTherapies = [];
    private IList<Therapy> DisplayedTherapies { get; set; } = [];
    private int TherapyCurrentPage { get; set; } = 1;
    private string TherapySearchTerm { get; set; } = string.Empty;
    private const int TherapyPageSize = 8;
    private int TherapyTotalPages => filteredTherapies.Count == 0 ? 1 : (int)Math.Ceiling((double)filteredTherapies.Count / TherapyPageSize);

    private string PatientPageTitle => patient == null
        ? "Paziente"
        : $"{patient.Title} {patient.FirstName} {patient.LastName}";

    private Therapy? LatestTherapy => allTherapies
        .OrderByDescending(t => t.CreatedDate)
        .ThenByDescending(t => t.TherapyId)
        .FirstOrDefault();

    protected override async Task OnParametersSetAsync()
    {
        patient = await patientRepository.GetByIdAsync(PatientId);
        allTherapies = (await repository.GetAllAsync(PatientId))
            .OrderByDescending(t => t.CreatedDate)
            .ThenByDescending(t => t.TherapyId)
            .ToList();

        TherapyCurrentPage = 1;
        await UpdateDisplayedTherapiesAsync();
    }

    private async Task PrintAsync(int id)
    {
        if (patient == null)
        {
            return;
        }

        var tabId = await jsRuntime.InvokeAsync<string?>("jsPreparePdfTab");

        try
        {
            var therapy = await repository.GetByIdAsync(id);
            if (therapy == null)
            {
                if (!string.IsNullOrWhiteSpace(tabId))
                {
                    await jsRuntime.InvokeVoidAsync("jsClosePreparedPdfTab", tabId);
                }
                return;
            }

            therapy.Patient ??= patient;

            var pdfBytes = await pdfService.GenerateTherapyPdfAsync(therapy);
            var pdfBase64 = Convert.ToBase64String(pdfBytes);
            var filename = $"{patient.FirstName}_{patient.LastName}_{therapy.CreatedDate:yy_MM_dd}_{DateTime.Now.ToFileTimeUtc()}.pdf";
            await jsRuntime.InvokeVoidAsync("jsSaveAsFile", tabId, filename, pdfBase64);
        }
        catch
        {
            if (!string.IsNullOrWhiteSpace(tabId))
            {
                await jsRuntime.InvokeVoidAsync("jsClosePreparedPdfTab", tabId);
            }
            throw;
        }
    }

    private void NavigateToDeleteTherapy(int id)
    {
        navigationManager.NavigateTo($"/patient/{id}/delete-therapy/");
    }

    private void NavigateToEditTherapy(int id)
    {
        navigationManager.NavigateTo($"/patient/{id}/edit-therapy/");
    }

    private async Task SearchTherapies(ChangeEventArgs e)
    {
        TherapySearchTerm = e.Value?.ToString() ?? string.Empty;
        TherapyCurrentPage = 1;
        await UpdateDisplayedTherapiesAsync();
    }

    private async Task HandleTherapySelectedPage(int page)
    {
        TherapyCurrentPage = page;
        await UpdateDisplayedTherapiesAsync();
    }

    private async Task PreviousTherapyPage()
    {
        if (TherapyCurrentPage > 1)
        {
            TherapyCurrentPage--;
            await UpdateDisplayedTherapiesAsync();
        }
    }

    private async Task NextTherapyPage()
    {
        if (TherapyCurrentPage < TherapyTotalPages)
        {
            TherapyCurrentPage++;
            await UpdateDisplayedTherapiesAsync();
        }
    }

    private async Task UpdateDisplayedTherapiesAsync()
    {
        await FilterTherapiesAsync();
        var startIndex = (TherapyCurrentPage - 1) * TherapyPageSize;
        DisplayedTherapies = filteredTherapies.Skip(startIndex).Take(TherapyPageSize).ToList();
    }

    private Task FilterTherapiesAsync()
    {
        if (string.IsNullOrWhiteSpace(TherapySearchTerm))
        {
            filteredTherapies = allTherapies.ToList();
            return Task.CompletedTask;
        }

        var term = TherapySearchTerm.Trim();
        filteredTherapies = allTherapies
            .Where(t =>
                (!string.IsNullOrWhiteSpace(t.Description) && t.Description.Contains(term, StringComparison.CurrentCultureIgnoreCase)) ||
                t.CreatedDate.ToString("dd/MM/yyyy").Contains(term, StringComparison.CurrentCultureIgnoreCase))
            .ToList();

        return Task.CompletedTask;
    }
}
