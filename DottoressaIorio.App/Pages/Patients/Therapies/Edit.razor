@page "/patient/{id:int}/edit-therapy"

@inject PatientTherapyRepository repository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager

<PageHeader Title="Modifica Terapia"/>

<EditForm Model="@model" OnValidSubmit="@SaveAsync" class="needs-validation" novalidate>
    <DataAnnotationsValidator/>
    @if (!string.IsNullOrEmpty(warningMessage))
    {
        <div class="alert alert-warning" role="alert">
            @warningMessage
        </div>
    }
    <div class="row g-3">
        <div class="col-12">
            <label for="Description">Descrizione:</label>
            <InputTextArea id="Description" @bind-Value="model.Description" class="form-control"/>
            <ValidationMessage For="@(() => model.Description)"/>
        </div>
    </div>

    <hr class="my-4">
    <CancelButton Url="@($"/patient/{model.PatientId}/")"/>
    <SubmitButton/>
</EditForm>

@code {
    [Parameter] public int Id { get; set; }

    private Therapy model;
    private string warningMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        try
        {
            await repository.UpdateAsync(model);
            await unitOfWork.SaveChangesAsync();
            navigationManager.NavigateTo($"/patient/{model.PatientId}/");
        }
        catch (Exception ex)
        {
            warningMessage = ValidationExceptionMapper.ToUserMessage(ex);
        }
    }

}