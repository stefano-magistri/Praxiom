@page "/patient/{id:int}/edit-therapy"

@inject PatientTherapyRepository repository
@inject PatientRepository patientRepository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

<ActionPageHeader Title="Modifica terapia"/>

<PatientContextCard Patient="patient" ShowHeaderName="true" UseCompactSummary="true"/>

<EditForm EditContext="@editContext" OnSubmit="@HandleSubmitAsync" class="needs-validation therapy-editor-form" novalidate>
    <DataAnnotationsValidator/>
    <ValidationWarningAlert Message="@warningMessage"/>
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }
    <TherapyDescriptionField Label="Descrizione:"
                             InputId="Description"
                             AriaLabel="Descrizione terapia"
                             TestId="therapy-description-editor"
                             Value="@EditorDescription"
                             ValueChanged="OnDescriptionChanged"
                             For="@(() => model.Description)"/>
    <FormActionSection>
        <div class="therapy-editor-actions" data-testid="therapy-form-actions">
            <CancelButton Url="@($"/patient/{model.PatientId}/")"/>
            <button type="button"
                    class="btn btn-outline-primary me-2"
                    disabled="@isSubmitting"
                    data-testid="therapy-print-button"
                    title="Stampa"
                    aria-label="Stampa"
                    @onclick="HandlePrintAsync">
                <span class="oi oi-print px-1" aria-hidden="true"></span>Stampa
            </button>
            <button type="submit"
                    class="btn btn-primary"
                    disabled="@isSubmitting"
                    data-testid="therapy-save-button"
                    @onclick="PrepareSaveAndClose">
                <span class="oi oi-beaker px-1" aria-hidden="true"></span>Salva
            </button>
        </div>
    </FormActionSection>
</EditForm>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "printStatus")] public string? PrintStatus { get; set; }

    private Patient? patient;
    private Therapy model = new();
    private EditContext editContext = default!;
    private string warningMessage = "";
    private string successMessage = "";
    private bool isSubmitting;
    private TherapySubmitAction pendingSubmitAction = TherapySubmitAction.SaveAndClose;
    private string EditorDescription => StringExtensions.ToEditorValue(model?.Description);

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
        ResetEditContext();
        if (model != null)
        {
            patient = await patientRepository.GetByIdAsync(model.PatientId);
        }

        successMessage = PrintStatus switch
        {
            "created" => "Terapia salvata e PDF aperto in una nuova scheda. Ora puoi continuare da questa schermata di modifica.",
            _ => string.Empty
        };
    }

    private void ResetEditContext()
    {
        editContext = new EditContext(model);
    }

    private void PrepareSaveAndClose()
    {
        pendingSubmitAction = TherapySubmitAction.SaveAndClose;
    }

    private async Task HandleSubmitAsync(EditContext _)
    {
        await SubmitAsync(pendingSubmitAction);
    }

    private async Task HandlePrintAsync()
    {
        pendingSubmitAction = TherapySubmitAction.SaveAndPrint;
        await SubmitAsync(TherapySubmitAction.SaveAndPrint);
    }

    private async Task SubmitAsync(TherapySubmitAction action)
    {
        if (isSubmitting)
        {
            return;
        }

        warningMessage = string.Empty;
        successMessage = string.Empty;

        if (!editContext.Validate())
        {
            return;
        }

        isSubmitting = true;

        try
        {
            if (!await SaveAsync())
            {
                return;
            }

            if (action == TherapySubmitAction.SaveAndPrint)
            {
                await OpenPrintAsync();
                successMessage = "PDF aperto in una nuova scheda. La terapia resta modificabile in questa pagina.";
                return;
            }

            navigationManager.NavigateTo($"/patient/{model.PatientId}/");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task<bool> SaveAsync()
    {
        try
        {
            model.Description = StringExtensions.NormalizeStoredRichText(model.Description);
            await repository.UpdateAsync(model);
            await unitOfWork.SaveChangesAsync();
            return true;
        }
        catch (Exception ex)
        {
            warningMessage = ValidationExceptionMapper.ToUserMessage(ex);
            return false;
        }
    }

    private static string FormatFullName(string? firstName, string? lastName)
    {
        return PatientNameFormatter.FormatFullName(firstName, lastName);
    }

    private async Task OpenPrintAsync()
    {
        var displayName = patient is null
            ? $"therapy_{model.TherapyId}.pdf"
            : $"{patient.FirstName}_{patient.LastName}.pdf";
        var encodedDisplayName = Uri.EscapeDataString(displayName);

        await jsRuntime.InvokeVoidAsync("open", $"/pdf/therapy/{model.TherapyId}/{encodedDisplayName}", "_blank");
    }

    private Task OnDescriptionChanged(string value)
    {
        model.Description = value;
        return Task.CompletedTask;
    }

    private enum TherapySubmitAction
    {
        SaveAndClose,
        SaveAndPrint
    }
}

