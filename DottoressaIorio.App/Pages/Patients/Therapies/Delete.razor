@page "/patient/{id:int}/delete-therapy"

@inject PatientTherapyRepository repository
@inject NavigationManager navigationManager

<PageHeader Title="Rimuovi Terapia" /> 

<p>Vuoi rimuovere questa terapia?</p>
 
<CancelButton Url="@($"/patient/{model.PatientId}/")" />
<RemoveButton OnClick="@SaveAsync" />
@code {
    [Parameter] public int Id { get; set; }

    private Therapy model;

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        await repository.DeleteAsync(model);
        navigationManager.NavigateTo($"/patient/{model.PatientId}/");
    }
}