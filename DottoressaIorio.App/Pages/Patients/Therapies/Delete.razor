@page "/patient/{id:int}/delete-therapy"

@inject PatientTherapyRepository repository
@inject IUnitOfWork unitOfWork
@inject NavigationManager navigationManager

<PageHeader Title="Rimuovi Terapia"/>

<ConfirmDeleteSection ConfirmationText="Vuoi rimuovere questa terapia?"
                      CancelUrl="@CancelUrl"
                      OnConfirm="@SaveAsync"/>

@code {
    [Parameter] public int Id { get; set; }

    private Therapy model;
    private string CancelUrl => model == null ? "/" : $"/patient/{model.PatientId}/";

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        await repository.DeleteAsync(model);
        await unitOfWork.SaveChangesAsync();
        navigationManager.NavigateTo($"/patient/{model.PatientId}/");
    }

}
