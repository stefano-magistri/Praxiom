@page "/patient/{id:int}/delete-therapy"

@inject PatientTherapyRepository repository
@inject NavigationManager navigationManager

<PageTitle>Rimuovi Terapia</PageTitle>
<h1>Rimuovi Terapia</h1>
<hr class="my-4">

<p>Vuoi rimuovere questa terapia?</p>

<a class="btn btn-secondary" href="/patient/@model.PatientId/">Annulla</a>
<button type="button" class="btn btn-danger" @onclick="@SaveAsync"><span class="oi oi-trash px-1" aria-hidden="true"></span>Rimuovi</button>
@code {
    [Parameter] public int Id { get; set; }

    private Therapy model;

    protected override async Task OnParametersSetAsync()
    {
        model = await repository.GetByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        await repository.DeleteAsync(model);
        navigationManager.NavigateTo($"/patient/{model.PatientId}/");
    }
}