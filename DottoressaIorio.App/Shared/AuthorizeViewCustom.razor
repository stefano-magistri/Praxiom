@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment Environment

<AuthorizeView Policy="SpecificUserOnly">
    <Authorized>
        @ChildContent
    </Authorized>
    <NotAuthorized>
        <p>Non sei autorizzato a visualizzare questo contenuto.</p>
        @if (!Environment.IsProduction())
        {
            var authenticationState = authenticationStateTask.Result;
            var user = authenticationState.User;
            <p>Ambiente corrente: @Environment.EnvironmentName</p>
            @if (user.Identity?.IsAuthenticated == true)
            {
                <p>Utente: @user.Identity.Name</p>
            }
            else
            {
                <p>Utente: non autenticato</p>
            }
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }

    private Task<AuthenticationState> authenticationStateTask;

    protected override async Task OnInitializedAsync()
    {
        authenticationStateTask = AuthenticationStateProvider.GetAuthenticationStateAsync();
        await authenticationStateTask;
    }
}