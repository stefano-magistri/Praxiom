@using System.Linq.Expressions

<div class="row g-3">
    <div class="col-12">
        <label for="@InputId">@Label</label>
        <MinimalRichTextEditor InputId="@InputId"
                               AriaLabel="@AriaLabel"
                               TestId="@TestId"
                               Value="@Value"
                               ValueChanged="@ValueChanged"/>
        <div class="therapy-description-help">@HelpText</div>
        @if (For is not null)
        {
            <ValidationMessage For="For"/>
        }
    </div>
</div>

@code {
    private const string DefaultHelpText =
        "Formato supportato nel PDF: paragrafi, grassetto, corsivo, elenco puntato e numerato.";

    [Parameter] [EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] [EditorRequired] public string InputId { get; set; } = string.Empty;

    [Parameter] [EditorRequired] public string AriaLabel { get; set; } = string.Empty;

    [Parameter] [EditorRequired] public string TestId { get; set; } = string.Empty;

    [Parameter] public string Value { get; set; } = string.Empty;

    [Parameter] [EditorRequired] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public Expression<Func<string?>>? For { get; set; }

    [Parameter] public string HelpText { get; set; } = DefaultHelpText;
}
