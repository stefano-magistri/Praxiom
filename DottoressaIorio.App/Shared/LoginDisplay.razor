@inject IWebHostEnvironment Environment
<AuthorizeView>
    <div class="px-4 auth" data-testid="user-greeting">
        Ciao, @context.User.Identity?.Name! 
        @if (!@Environment.IsProduction())
        {
            <small class="text-muted">@Environment.EnvironmentName</small>
        }
    </div>
</AuthorizeView>
