@inject IJSRuntime jsRuntime

<nav id="sidebarMenu"
     class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
    <div class="position-sticky p-3">
        <div class="sidebar-brand">
            <div class="sidebar-product-name">Dottoressa Iorio</div>
            <div class="sidebar-product-subtitle">@StudioDisplayName</div>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" data-testid="patients-nav-link" @onclick="CloseSidebar">
                    <span data-feather="users"></span> Pazienti
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="create-patient" data-testid="create-patient-nav-link" @onclick="CloseSidebar">
                    <span data-feather="plus-circle" aria-hidden="true"></span> Aggiungi Paziente
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="therapy-templates" data-testid="therapy-templates-nav-link" @onclick="CloseSidebar">
                    <span data-feather="layers"></span> Terapie Precompilate
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="create-therapy-template" data-testid="create-therapy-template-nav-link" @onclick="CloseSidebar">
                    <span data-feather="plus-circle" aria-hidden="true"></span> Aggiungi Precompilato
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" aria-current="page" href="guide" data-testid="guide-nav-link" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                    <span data-feather="home"></span> Guida
                </NavLink>
            </li>
            <li class="sidebar-footer">
                <div class="copyright">
                    <div>Version @AppVersion</div>
                    <a target="_blank" href="mailto:stefanomagistri@gmail.com?subject=Dottoressa Iorio App%20Support%20Request">Support</a>
                </div>
            </li>
        </ul>
    </div>

</nav>

@code {
    [Parameter] public string AppVersion { get; set; } = "unknown";

    [Parameter] public string StudioDisplayName { get; set; } = "Studio: Alessandra Iorio";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await jsRuntime.InvokeVoidAsync("jsLoadFeather");
    }

    private async Task CloseSidebar()
    {
        await jsRuntime.InvokeVoidAsync("jsCloseNavbar");
    }

}