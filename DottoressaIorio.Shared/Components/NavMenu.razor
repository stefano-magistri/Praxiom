@inject IJSRuntime jsRuntime
@inject DottoressaIorio.Shared.State.ClinicSettingsState ClinicSettingsState
@inject DottoressaIorio.Shared.Branding.ProductBrandingOptions Branding
@implements IDisposable

<nav id="sidebarMenu"
     class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
    <div class="position-sticky p-3">
        <div class="sidebar-brand">
            <div class="sidebar-product-name">@SidebarTitle</div>
            @if (!string.IsNullOrWhiteSpace(SidebarClinicName))
            {
                <div class="sidebar-product-subtitle">@SidebarClinicName</div>
            }
            @if (!string.IsNullOrWhiteSpace(SidebarDetails))
            {
                <div class="sidebar-product-meta">@SidebarDetails</div>
            }
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" data-testid="patients-nav-link" @onclick="CloseSidebar">
                    <span data-feather="users"></span> Pazienti
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="therapy-templates" data-testid="therapy-templates-nav-link" @onclick="CloseSidebar">
                    <span data-feather="layers"></span> Terapie
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" aria-current="page" href="guide" data-testid="guide-nav-link" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                    <span data-feather="home"></span> Guida
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link" href="settings" data-testid="settings-nav-link" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                    <span data-feather="settings"></span> Impostazioni
                </NavLink>
            </li>
            <li class="sidebar-footer">
                <div class="copyright">
                    <div class="copyright-version-wrap">
                        <span class="copyright-label">Versione</span>
                        <span class="copyright-version">@AppVersion</span>
                    </div>
                    <a class="copyright-support" href="@SupportLink">Supporto</a>
                </div>
            </li>
        </ul>
    </div>

</nav>

@code {
    [Parameter] public string AppVersion { get; set; } = "sconosciuta";
    private global::DottoressaIorio.Models.ClinicSettings? clinicSettings;

    private string SidebarTitle => string.IsNullOrWhiteSpace(clinicSettings?.DoctorName)
        ? Branding.StudioDisplayName
        : clinicSettings.DoctorName;

    private string SidebarClinicName => clinicSettings?.ClinicName ?? string.Empty;

    private string SidebarDetails =>
        string.Join(" • ", new[]
        {
            clinicSettings?.DoctorTitle,
            clinicSettings?.Phone
        }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string SupportLink =>
        $"mailto:{Branding.SupportEmailAddress}?subject={Uri.EscapeDataString(Branding.SupportEmailSubject)}";

    protected override async Task OnInitializedAsync()
    {
        clinicSettings = await ClinicSettingsState.GetAsync();
        ClinicSettingsState.Changed += HandleClinicSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await jsRuntime.InvokeVoidAsync("jsLoadFeather");
    }

    private async Task CloseSidebar()
    {
        await jsRuntime.InvokeVoidAsync("jsCloseNavbar");
    }

    private void HandleClinicSettingsChanged()
    {
        clinicSettings = ClinicSettingsState.Current;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ClinicSettingsState.Changed -= HandleClinicSettingsChanged;
    }
}
