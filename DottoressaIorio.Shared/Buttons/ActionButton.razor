<button type="button" class="btn btn-@ButtonClass" @onclick="OnClick">
    <span class="@IconClass @(string.IsNullOrEmpty(ButtonText) ? "" : "px-1")" aria-hidden="true"></span>@ButtonText
</button>

@code {
    [Parameter, EditorRequired]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public string ButtonText { get; set; }

    [Parameter, EditorRequired]
    public string ButtonClass { get; set; }

    [Parameter, EditorRequired]
    public string IconClass { get; set; }
}